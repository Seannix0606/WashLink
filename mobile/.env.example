# Public values only. Never put a service role key in this app: everything here ships inside the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Build settings, kept in EAS environment variables rather than in source control.
GOOGLE_MAPS_ANDROID_API_KEY=
EAS_PROJECT_ID=

# Washer sign-up, closed while WashLink operates the washes itself. Turn on together with the database switch
# (platform_settings.washer_signup_open) to reopen it.
EXPO_PUBLIC_FEATURE_WASHER_SIGNUP=false
