VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shop owner (B2B) features. Off for the B2C release; see docs/b2c/B2B_REACTIVATION.md.
VITE_FEATURE_B2B=false

# Washer sign-up, closed while WashLink operates the washes itself. Turn on together with the database switch
# (platform_settings.washer_signup_open) to reopen it; see docs/b2c/OPERATOR_MODE.md.
VITE_FEATURE_WASHER_SIGNUP=false
