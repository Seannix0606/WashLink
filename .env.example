# Copy this file to .env and add the Supabase project URL and anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local backend defaults. The SQLite database is stored in a Docker volume.
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite+aiosqlite:////data/washlink.db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-secret-key-change-me
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
